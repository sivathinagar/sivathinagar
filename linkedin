<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sivaraman Thinagar — Mechanical Design Engineer</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --navy: #0d1b2a;
    --navy-mid: #1a2f45;
    --steel: #2c4a6e;
    --accent: #c8a96e;
    --accent-light: #e8d5a8;
    --off-white: #f5f2ed;
    --text-muted: #8a9bb0;
    --border: rgba(200,169,110,0.2);
    --serif: 'DM Serif Display', Georgia, serif;
    --sans: 'DM Sans', system-ui, sans-serif;
  }

  html { scroll-behavior: smooth; }
  body { font-family: var(--sans); background: var(--navy); color: var(--off-white); overflow-x: hidden; }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 1.25rem 3rem;
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
    background: rgba(13,27,42,0.88);
  }
  .nav-logo { font-family: var(--serif); font-size: 1.1rem; color: var(--accent); }
  .nav-links { display: flex; gap: 2rem; list-style: none; }
  .nav-links a {
    text-decoration: none; font-size: 0.8rem; font-weight: 300;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-muted); transition: color 0.25s;
  }
  .nav-links a:hover { color: var(--accent); }

  /* HERO */
  #hero {
    min-height: 100vh;
    display: grid; grid-template-columns: 1fr 420px;
    align-items: center;
    padding: 8rem 3rem 4rem;
    gap: 4rem;
    position: relative; overflow: hidden;
  }
  .hero-grid-bg {
    position: absolute; inset: 0; opacity: 0.035;
    background-image:
      linear-gradient(rgba(200,169,110,0.8) 1px, transparent 1px),
      linear-gradient(90deg, rgba(200,169,110,0.8) 1px, transparent 1px);
    background-size: 60px 60px;
  }
  .hero-left { position: relative; z-index: 1; }
  .hero-tag {
    font-size: 0.74rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .hero-tag::before { content: ''; display: block; width: 40px; height: 1px; background: var(--accent); }
  h1.hero-name {
    font-family: var(--serif);
    font-size: clamp(3.2rem, 7vw, 6rem);
    line-height: 1.0; font-weight: 400;
    margin-bottom: 1.5rem;
  }
  h1.hero-name em { font-style: italic; color: var(--accent); }
  .hero-intro {
    font-size: 1.05rem; font-weight: 300; line-height: 1.85;
    color: rgba(245,242,237,0.68); max-width: 520px; margin-bottom: 2.5rem;
  }
  .hero-cta { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: var(--accent); color: var(--navy);
    padding: 0.85rem 2rem;
    font-size: 0.8rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
    text-decoration: none; border: none; cursor: pointer;
    transition: background 0.25s, transform 0.2s;
  }
  .btn-primary:hover { background: var(--accent-light); transform: translateY(-2px); }
  .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.5rem;
    border: 1px solid var(--border); color: var(--off-white);
    padding: 0.85rem 2rem;
    font-size: 0.8rem; font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase;
    text-decoration: none; cursor: pointer;
    transition: border-color 0.25s, transform 0.2s;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

  /* HERO PHOTO */
  .hero-right { position: relative; z-index: 1; display: flex; justify-content: center; }
  .photo-frame {
    position: relative; width: 340px;
  }
  .photo-frame::before {
    content: ''; position: absolute;
    top: 20px; left: 20px; right: -20px; bottom: -20px;
    border: 1px solid var(--border);
    z-index: 0;
  }
  .photo-frame img {
    width: 100%; display: block;
    position: relative; z-index: 1;
    filter: grayscale(15%);
    object-fit: cover;
  }
  .photo-badge {
    position: absolute; bottom: -16px; left: -16px; z-index: 2;
    background: var(--accent); color: var(--navy);
    padding: 0.75rem 1.25rem;
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
  }

  /* HERO STATS BAR */
  .hero-stats-bar {
    background: var(--navy-mid);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
  }
  .stat-block {
    flex: 1; padding: 1.75rem 2rem;
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column; gap: 0.3rem;
  }
  .stat-block:last-child { border-right: none; }
  .stat-num { font-family: var(--serif); font-size: 2rem; color: var(--accent); }
  .stat-label { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); }

  /* SECTION COMMONS */
  section { padding: 6rem 3rem; }
  .section-label {
    font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 0.75rem;
    display: flex; align-items: center; gap: 0.75rem;
  }
  .section-label::before { content: ''; display: block; width: 30px; height: 1px; background: var(--accent); }
  h2.section-title {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400; line-height: 1.15; margin-bottom: 3rem;
  }

  /* WHAT I DO — ROLES */
  #roles { background: var(--navy-mid); }
  .roles-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    border: 1px solid var(--border);
  }
  .role-card {
    padding: 2.5rem 2rem;
    border-right: 1px solid var(--border);
    transition: background 0.3s;
  }
  .role-card:last-child { border-right: none; }
  .role-card:hover { background: rgba(200,169,110,0.05); }
  .role-icon {
    width: 44px; height: 44px; margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent); font-size: 1.2rem;
  }
  .role-title {
    font-family: var(--serif); font-size: 1.3rem; margin-bottom: 1rem;
  }
  .role-desc {
    font-size: 0.88rem; font-weight: 300; line-height: 1.8;
    color: rgba(245,242,237,0.6);
  }
  .role-skills {
    margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem;
  }
  .role-skill {
    font-size: 0.7rem; padding: 0.25rem 0.65rem;
    border: 1px solid var(--border); color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  /* ABOUT */
  #about { background: var(--navy); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; max-width: 1100px; }
  .about-text { font-size: 1rem; font-weight: 300; line-height: 1.9; color: rgba(245,242,237,0.72); }
  .about-text p + p { margin-top: 1.2rem; }
  .about-details { display: flex; flex-direction: column; gap: 1.5rem; }
  .detail-label { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.25rem; }
  .detail-value { font-size: 0.92rem; color: var(--off-white); }
  .skills-grid { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .skill-tag {
    padding: 0.3rem 0.85rem; border: 1px solid var(--border);
    font-size: 0.76rem; letter-spacing: 0.04em; color: var(--text-muted);
    transition: border-color 0.2s, color 0.2s;
  }
  .skill-tag:hover { border-color: var(--accent); color: var(--accent); }

  /* EXPERIENCE */
  #experience { background: var(--navy-mid); }
  .timeline { max-width: 820px; }
  .timeline-item {
    display: grid; grid-template-columns: 150px 1fr;
    gap: 2rem; padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .timeline-item:last-child { border-bottom: none; }
  .timeline-date { font-size: 0.76rem; font-weight: 300; color: var(--text-muted); padding-top: 0.2rem; letter-spacing: 0.04em; }
  .timeline-role { font-family: var(--serif); font-size: 1.25rem; margin-bottom: 0.2rem; }
  .timeline-company { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 1rem; }
  .timeline-desc { font-size: 0.88rem; font-weight: 300; line-height: 1.8; color: rgba(245,242,237,0.62); }
  .timeline-achievements { margin-top: 0.85rem; list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
  .timeline-achievements li {
    font-size: 0.84rem; font-weight: 300; color: rgba(245,242,237,0.58);
    padding-left: 1rem; position: relative;
  }
  .timeline-achievements li::before { content: '→'; position: absolute; left: 0; color: var(--accent); font-size: 0.74rem; }

  /* PORTFOLIO */
  #portfolio { background: var(--navy); }
  .portfolio-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .project-card {
    background: var(--navy-mid); border: 1px solid var(--border);
    overflow: hidden; transition: transform 0.3s, border-color 0.3s; cursor: pointer;
  }
  .project-card:hover { transform: translateY(-5px); border-color: var(--accent); }
  .project-img {
    height: 180px; display: flex; align-items: center; justify-content: center;
    overflow: hidden; position: relative;
  }
  .project-num {
    position: absolute; top: 1rem; left: 1rem;
    font-size: 0.68rem; letter-spacing: 0.15em;
    color: var(--accent); background: rgba(13,27,42,0.85); padding: 0.2rem 0.6rem;
  }
  .project-info { padding: 1.5rem; }
  .project-cat { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.4rem; }
  .project-name { font-family: var(--serif); font-size: 1.15rem; margin-bottom: 0.65rem; }
  .project-desc { font-size: 0.82rem; font-weight: 300; line-height: 1.75; color: rgba(245,242,237,0.58); }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 1rem; }
  .project-tag { font-size: 0.68rem; padding: 0.2rem 0.55rem; background: rgba(200,169,110,0.08); color: var(--accent); letter-spacing: 0.04em; }

  /* THESIS */
  #thesis { background: var(--navy-mid); }
  .thesis-card {
    max-width: 900px; border: 1px solid var(--border);
    padding: 3rem; position: relative; overflow: hidden;
  }
  .thesis-card::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px; background: var(--accent);
  }
  .thesis-institution { font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; }
  .thesis-title { font-family: var(--serif); font-size: clamp(1.3rem, 2.5vw, 1.9rem); margin-bottom: 1.25rem; line-height: 1.3; }
  .thesis-desc { font-size: 0.93rem; font-weight: 300; line-height: 1.9; color: rgba(245,242,237,0.68); margin-bottom: 2rem; }
  .thesis-outcomes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .outcome-num { font-family: var(--serif); font-size: 1.8rem; color: var(--accent); display: block; margin-bottom: 0.2rem; }
  .outcome-label { font-size: 0.73rem; font-weight: 300; color: rgba(245,242,237,0.52); line-height: 1.5; }

  /* PUBLICATIONS */
  #publications { background: var(--navy); }
  .pub-list { max-width: 800px; display: flex; flex-direction: column; gap: 1.25rem; }
  .pub-item { padding: 1.6rem; border: 1px solid var(--border); transition: border-color 0.2s; }
  .pub-item:hover { border-color: var(--accent); }
  .pub-type { font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.4rem; }
  .pub-title { font-size: 0.95rem; font-weight: 400; line-height: 1.65; margin-bottom: 0.65rem; }
  .pub-meta { font-size: 0.76rem; color: var(--text-muted); font-weight: 300; }

  /* CONTACT */
  #contact { background: var(--navy-mid); text-align: center; }
  .contact-inner { max-width: 580px; margin: 0 auto; }
  .contact-title { font-family: var(--serif); font-size: clamp(2rem, 4vw, 3rem); margin-bottom: 1rem; }
  .contact-sub { font-size: 1rem; font-weight: 300; color: rgba(245,242,237,0.6); margin-bottom: 2.5rem; line-height: 1.8; }
  .contact-links { display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap; }
  .contact-link {
    display: flex; align-items: center; gap: 0.5rem;
    text-decoration: none; color: var(--text-muted);
    font-size: 0.83rem; letter-spacing: 0.04em; transition: color 0.2s;
  }
  .contact-link:hover { color: var(--accent); }
  .contact-link svg { width: 17px; height: 17px; }

  footer {
    padding: 1.75rem 3rem;
    border-top: 1px solid var(--border);
    display: flex; justify-content: space-between; align-items: center;
    font-size: 0.74rem; color: var(--text-muted); font-weight: 300;
  }

  /* ANIMATIONS */
  .fade-up { opacity: 0; transform: translateY(28px); animation: fadeUp 0.75s ease forwards; }
  @keyframes fadeUp { to { opacity: 1; transform: translateY(0); } }
  .fade-up:nth-child(1) { animation-delay: 0.1s; }
  .fade-up:nth-child(2) { animation-delay: 0.25s; }
  .fade-up:nth-child(3) { animation-delay: 0.4s; }
  .fade-up:nth-child(4) { animation-delay: 0.55s; }
  .fade-up:nth-child(5) { animation-delay: 0.65s; }

  @media (max-width: 900px) {
    #hero { grid-template-columns: 1fr; padding: 7rem 1.5rem 3rem; }
    .hero-right { display: none; }
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    section { padding: 4rem 1.5rem; }
    .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .timeline-item { grid-template-columns: 1fr; gap: 0.4rem; }
    .thesis-outcomes { grid-template-columns: 1fr; gap: 1rem; }
    .roles-grid { grid-template-columns: 1fr; }
    .role-card { border-right: none; border-bottom: 1px solid var(--border); }
    .hero-stats-bar { flex-wrap: wrap; }
    .stat-block { min-width: 50%; }
  }
</style>
</head>
