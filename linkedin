      </div>
      <div>
        <div class="detail-label">Education</div>
        <div class="detail-value">M.Sc. Mechatronics & Automation — ZHAW (2023–2025)</div>
      </div>
      <div>
        <div class="detail-label">Languages</div>
        <div class="detail-value">English C1 · German B1 · Tamil Native</div>
      </div>
      <div>
        <div class="detail-label">Work Permit</div>
        <div class="detail-value">Permit B · Immediate availability · 100%</div>
      </div>
      <div class="skills-grid">
        <span class="skill-tag">SolidWorks</span>
        <span class="skill-tag">Inventor</span>
        <span class="skill-tag">Fusion 360</span>
        <span class="skill-tag">CATIA V5</span>
