<!-- WHAT I DO -->
<section id="roles">
  <div class="section-label">What I Do</div>
  <h2 class="section-title">Three areas.<br>One engineer.</h2>
  <div class="roles-grid">

    <div class="role-card">
      <div class="role-icon">
